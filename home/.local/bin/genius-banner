#!/bin/sh
# Banner (GENIUS_BANNER, default #user) in a cold cyan -> blue -> violet gradient (truecolor).
figlet -f slant "${GENIUS_BANNER:-#$(id -un)}" | awk '
BEGIN { n = 3; split("111 227 232 108 170 255 176 124 255", c, " ") }
{ w = length($0); out = ""
  for (i = 1; i <= w; i++) {
    t = (w > 1) ? (i - 1) / (w - 1) * (n - 1) : 0; k = int(t); if (k >= n - 1) k = n - 2; f = t - k
    r = c[k*3+1] + (c[k*3+4] - c[k*3+1]) * f; g = c[k*3+2] + (c[k*3+5] - c[k*3+2]) * f; b = c[k*3+3] + (c[k*3+6] - c[k*3+3]) * f
    out = out sprintf("\033[1;38;2;%d;%d;%dm%s", r, g, b, substr($0, i, 1)) }
  print out "\033[0m" }'
