#!/usr/bin/env python3
"""Warp-speed starfield in the cold palette. Any key exits (used as a tmux lock screen)."""
import curses, random, time

def main(scr):
    curses.curs_set(0); scr.nodelay(True); curses.start_color(); curses.use_default_colors()
    # dim -> bright: grey-blue, blue, cyan, white
    for i, c in enumerate((60, 69, 80, 159, 231), 1):
        curses.init_pair(i, c if curses.COLORS >= 256 else curses.COLOR_CYAN, -1)
    stars = []
    while True:
        h, w = scr.getmaxyx()
        while len(stars) < 220:
            stars.append([random.uniform(-1, 1), random.uniform(-1, 1), random.uniform(0.05, 1.0)])
        scr.erase()
        for s in stars:
            s[2] -= 0.012
            if s[2] <= 0.02:
                s[:] = [random.uniform(-1, 1), random.uniform(-1, 1), 1.0]
            x, y = int(w / 2 + s[0] / s[2] * w / 4), int(h / 2 + s[1] / s[2] * h / 4)
            if 0 <= x < w - 1 and 0 <= y < h:
                lvl = min(5, 1 + int((1 - s[2]) * 5))
                scr.addstr(y, x, "·.*+@"[lvl - 1], curses.color_pair(lvl) | (curses.A_BOLD if lvl >= 4 else 0))
        scr.refresh()
        if scr.getch() != -1:
            return
        time.sleep(0.03)

curses.wrapper(main)
